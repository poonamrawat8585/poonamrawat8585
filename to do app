<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>To-Do App</title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background: #f8f9fa;
    }
    .todo-container {
      max-width: 500px;
      margin: 50px auto;
      background: white;
      padding: 20px;
      border-radius: 12px;
      box-shadow: 0px 4px 8px rgba(0,0,0,0.1);
    }
    .completed {
      text-decoration: line-through;
      color: gray;
    }
    .empty-msg {
      text-align: center;
      color: #888;
      margin-top: 20px;
    }
  </style>
</head>
<body>
  <div class="todo-container">
    <h3 class="text-center mb-3">📝 To-Do App</h3>
    
    <!-- Input -->
    <div class="input-group mb-3">
      <input type="text" id="taskInput" class="form-control" placeholder="Enter a task...">
      <button class="btn btn-primary" id="addTaskBtn">Add</button>
    </div>

    <!-- Task List -->
    <ul class="list-group" id="taskList"></ul>
    <p class="empty-msg" id="emptyMsg">No tasks yet. Add one!</p>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const taskInput = document.getElementById("taskInput");
    const addTaskBtn = document.getElementById("addTaskBtn");
    const taskList = document.getElementById("taskList");
    const emptyMsg = document.getElementById("emptyMsg");

    let tasks = JSON.parse(localStorage.getItem("tasks")) || [];

    // Display tasks on page load
    window.onload = () => {
      renderTasks();
    };

    // Add task
    function addTask() {
      const taskText = taskInput.value.trim();
      if (taskText === "") return;

      const task = { text: taskText, completed: false };
      tasks.push(task);
      saveTasks();
      renderTasks();

      taskInput.value = "";
    }

    // Render tasks
    function renderTasks() {
      taskList.innerHTML = "";
      if (tasks.length === 0) {
        emptyMsg.style.display = "block";
        return;
      }
      emptyMsg.style.display = "none";

      tasks.forEach((task, index) => {
        const li = document.createElement("li");
        li.className = "list-group-item d-flex justify-content-between align-items-center";

        const span = document.createElement("span");
        span.textContent = task.text;
        if (task.completed) span.classList.add("completed");
        span.style.cursor = "pointer";

        // Toggle complete
        span.onclick = () => {
          task.completed = !task.completed;
          saveTasks();
          renderTasks();
        };

        const delBtn = document.createElement("button");
        delBtn.className = "btn btn-danger btn-sm";
        delBtn.textContent = "Delete";
        delBtn.onclick = () => {
          tasks.splice(index, 1);
          saveTasks();
          renderTasks();
        };

        li.appendChild(span);
        li.appendChild(delBtn);
        taskList.appendChild(li);
      });
    }

    // Save to localStorage
    function saveTasks() {
      localStorage.setItem("tasks", JSON.stringify(tasks));
    }

    // Event listeners
    addTaskBtn.addEventListener("click", addTask);
    taskInput.addEventListener("keypress", (e) => {
      if (e.key === "Enter") addTask();
    });
  </script>
</body>
</html>

